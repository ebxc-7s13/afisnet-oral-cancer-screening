# =============================================================================
# .gitignore for the repository accompanying:
#   "Quality Controlled Synthetic Augmentation for AI-Enabled Label-free
#    Digital Cytology of Oral Cancer Screening"
#
# Structure: GitHub's standard Python template (trimmed to what this project
# can actually produce), followed by project-specific rules. Clinical images,
# GAN outputs, model checkpoints and all runtime artefacts must never be
# committed.
# =============================================================================

# ---- Byte-compiled / cache files (GitHub Python template) -------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- Distribution / packaging (GitHub Python template) ----------------------
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
wheels/
*.egg-info/
*.egg
MANIFEST

# ---- Unit tests / coverage (GitHub Python template) -------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ---- Virtual environments (GitHub Python template) --------------------------
.env
.venv
env/
venv/
ENV/
.python-version

# ---- Type checkers / tooling caches (GitHub Python template) ----------------
.mypy_cache/
.ruff_cache/
.pyre/

# ---- Jupyter (GitHub Python template) ---------------------------------------
.ipynb_checkpoints/

# ---- IDE / editor / OS ------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# =============================================================================
# Project-specific rules
# =============================================================================

# Clinical images are never distributed via git (privacy / ethics).
data/

# Pipeline outputs of every stage.
outputs/
results/
checkpoints/
logs/
runs/

# Legacy / alternative output locations.
final_generated/
Stage3_Screening/
KFOLDRESULTS/

# Model weights and tensor dumps (attach released weights to a GitHub
# Release instead of committing them).
*.pt
*.pth
*.ckpt
*.onnx
*.npy
*.npz

# Generated archives, logs, temporary files, embedding caches.
*.zip
*.log
*.tmp
.cache/

# TensorBoard event files.
events.out.tfevents.*
